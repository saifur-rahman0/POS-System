# Environment
ENVIRONMENT=development
DEBUG=true

# Database Configuration (authoritative local shop PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pos_db
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=change_this_to_a_secure_password
DATABASE_URL=postgresql+asyncpg://pos_user:change_this_to_a_secure_password@localhost:5432/pos_db

# Security & Authentication (Argon2id + JWT)
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_random_32_byte_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Licensing
# Embedded public key path for offline asymmetric signature verification
LICENSE_PUBLIC_KEY_PATH=secrets/license_public.pem

# CORS / Network (Shop LAN terminals)
CORS_ORIGINS=["http://localhost", "http://127.0.0.1", "http://192.168.*"]

# Timezone
TIMEZONE=Asia/Dhaka

